{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SAYNAY Launcher",
  "version": "0.1.0",
  "identifier": "gg.saynay.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SAYNAY Launcher",
        "width": 1180,
        "height": 760,
        "minWidth": 960,
        "minHeight": 640,
        "backgroundColor": "#05060d"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Game",
    "shortDescription": "Minecraft Java performance launcher",
    "longDescription": "SAYNAY Launcher installs and launches the original Minecraft Java Edition with hardware-aware performance profiles, Fabric optimization mods and a real benchmark engine.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": { "../assets/bench/": "bench/" },
    "macOS": { "minimumSystemVersion": "10.15" },
    "windows": { "wix": { "language": "en-US" } }
  }
}
